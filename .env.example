# ==============================================================================
# ChatTime Production & Custom Domain Configuration (.env.example)
# Domain: chattimeapp.name.ng
# ==============================================================================

# Core App & Custom Domain
# In Cloud Run / AI Studio, APP_URL is automatically injected.
# Set CUSTOM_DOMAIN to your registered domain: chattimeapp.name.ng
APP_URL="https://chattimeapp.name.ng"
CUSTOM_DOMAIN="chattimeapp.name.ng"
VITE_APP_DOMAIN="chattimeapp.name.ng"

# ==============================================================================
# Web Push (required for lock-screen message and incoming-call alerts)
# Generate a pair with: npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY secret and configure it in the production environment.
# The phone/OS chooses notification sound; web push cannot force a native ringtone.
# ==============================================================================
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:notifications@chattimeapp.name.ng"

# Gemini API Key (Required for AI Speech Synthesis TTS and translation)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Krisp Speech & Audio Platform API Key (Private server environment variable only)
# Used by backend endpoint POST /api/krisp/session-token to fetch short-lived tokens from
# https://api.developers.krisp.ai/v2/sdk/tokens/session (Supports: stt, tts, vt, viva)
KRISP_API_KEY="YOUR_KRISP_API_KEY"
KRISP_RTC_API_KEY="YOUR_KRISP_RTC_API_KEY"

# ==============================================================================
# SMTP Email Secrets (For sending verification codes from code@chattimeapp.name.ng)
# Sender Display: "Chat Time Business" <code@chattimeapp.name.ng>
# ==============================================================================
# Set your mail server details (e.g., Google Workspace, Namecheap Private Email,
# Zoho Mail, Amazon SES, Brevo, SendGrid, or Mailgun):
SMTP_HOST="mail.chattimeapp.name.ng"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="code@chattimeapp.name.ng"
SMTP_PASS="YOUR_EMAIL_ACCOUNT_PASSWORD_OR_APP_PASSWORD"
SMTP_FROM="Chat Time Business <code@chattimeapp.name.ng>"

# Alternative: Resend API Key (if using resend.com for chattimeapp.name.ng)
# RESEND_API_KEY="re_123456789"

# ==============================================================================
# DNS RECORDS TO CONFIGURE AT YOUR DOMAIN REGISTRAR FOR chattimeapp.name.ng
# ==============================================================================
# 1. Web Traffic (CNAME or A Record):
#    Host: @ or chattimeapp.name.ng
#    Points to: Your Cloud Run URL (e.g., ais-dev-sxz5y5tufqt4ji4dglxpaa-830519613420.europe-west2.run.app)
#
# 2. Email Sender (SPF TXT Record):
#    Host: @
#    Value: "v=spf1 include:_spf.yourmailserver.com ~all"
#
# 3. DMARC TXT Record:
#    Host: _dmarc
#    Value: "v=DMARC1; p=none; rua=mailto:code@chattimeapp.name.ng"
# ==============================================================================
